# Copy to backend/.env and fill in. Never commit the real .env.

# ── AI providers (at least one key required) ────────────────────────────────
# OpenAI-compatible provider, tried first.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-astra
# Groq, used automatically if the OpenAI provider fails.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── GitHub App (required) ────────────────────────────────────────────────────
# From the GitHub App settings page.
GITHUB_APP_ID=
# Contents of the downloaded .pem file. Escaped "\n" line breaks are accepted.
GITHUB_APP_PRIVATE_KEY=
# Must match the webhook secret configured on the GitHub App.
GITHUB_WEBHOOK_SECRET=

# ── Setup-page sign-in (required for the setup page) ────────────────────────
# From the GitHub App settings page: Client ID and a generated client secret.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Random string of at least 32 characters used to sign session cookies.
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Optional. Set when the App lists several redirect URLs (e.g. production + ngrok),
# to the one this server should use, e.g. https://YOUR-HOST/api/auth/github/callback
GITHUB_OAUTH_REDIRECT_URI=

# ── Database (required) ──────────────────────────────────────────────────────
# MongoDB connection string for conventions, custom rules, and configurations.
# e.g. mongodb+srv://user:pass@cluster.mongodb.net  or  mongodb://localhost:27017
MONGODB_URL=

# ── Server (optional) ────────────────────────────────────────────────────────
# Port the Express server listens on. Defaults to 3000.
PORT=3000
# Comma-separated origins allowed for cross-origin API calls.
# Defaults to https://pr-hawk.vercel.app plus localhost:5173 and localhost:3000.
FRONTEND_ORIGIN=https://pr-hawk.vercel.app

# ── Review size limits (optional) ────────────────────────────────────────────
# Defaults shown. ~4 characters per token.
# REVIEW_MAX_PROMPT_CHARS=60000
# REVIEW_MAX_PATCH_CHARS_PER_FILE=8000
# REVIEW_CONTEXT_LINES=30
# REVIEW_MAX_CONVENTIONS=40

# ── CLI only (optional) ──────────────────────────────────────────────────────
# Personal access token used by `npm run review` / `npm run learn`, and as a
# fallback for webhooks when GitHub App credentials are not configured.
GITHUB_TOKEN=
