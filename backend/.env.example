# ── LLM Provider (at least one required) ────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-astra
GROQ_MODEL=openai/gpt-oss-120b
# OpenAI is tried first. Groq is used automatically if OpenAI fails.
OPENROUTER_API_KEY=
GROQ_API_KEY=

# ── GitHub (required) ────────────────────────────────────────────────────────
# GitHub App credentials used by webhook automation.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ── Model (optional) ─────────────────────────────────────────────────────────
# Model to use. Defaults to:
#   "google/gemini-2.5-flash"   when OPENROUTER_API_KEY is set
#   "llama-3.3-70b-versatile"   otherwise (Groq)
# ── Server (optional) ────────────────────────────────────────────────────────
# Port the Express server listens on. Defaults to 3000.
PORT=3000

# ── Database (required) ──────────────────────────────────────────────────────
# MongoDB connection string used for installation/repository conventions.
# Required by webhook reviews that use learned conventions.
# e.g. mongodb+srv://user:pass@cluster.mongodb.net  or  mongodb://localhost:27017
MONGODB_URL=

# ── Webhook automation ───────────────────────────────────────────────────────
