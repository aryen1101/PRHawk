# Base URL of the PRHawk backend API.
# Leave empty for local development to use the Vite dev proxy (see vite.config.js),
# which forwards "/api" to http://localhost:3000.
# Set this to your deployed backend (e.g. https://prhawk-1.onrender.com) for builds.
VITE_API_BASE_URL=
VITE_GITHUB_APP_INSTALL_URL=https://github.com/apps/prhawk-webhook-tester/installations/new
