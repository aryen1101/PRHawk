# Public frontend configuration. These values are safe to expose in the browser.
# Leave empty in production: Vercel proxies /api to Render (see vercel.json) so
# the session cookie stays first-party. Locally, Vite proxies /api to :3000.
VITE_API_BASE_URL=
VITE_GITHUB_APP_INSTALL_URL=https://github.com/apps/your-github-app/installations/new
